#include <iostream>
using namespace std;

int main() {
    int number, reversed = 0, remainder;

    cout << "=== Number Reverser ===\n";

    // Input the number
    cout << "Enter an integer: ";
    cin >> number;

    int original = number;  // Store original number

    // Reverse the digits
    while (number != 0) {
        remainder = number % 10;             // Get the last
        reversed = reversed * 10 + remainder; // Append digit to reversed number
        number = number / 10;                // Remove last digit
    }

    // Display the result
    cout << "Reversed of " << original << " is: " << reversed << endl;

    return 0;
}
